# Copy this file to .env.production on the VPS/Dokploy server.
# Never commit real secrets.

# Public domains
FRONTEND_URL=https://app.estudiarapp.com
VITE_API_URL=https://api.estudiarapp.com/api

# Host ports exposed by Docker. In Dokploy, route domains to these services/ports.
FRONTEND_PORT=8080
BACKEND_PORT=3001

# PostgreSQL
POSTGRES_DB=estudiarapp
POSTGRES_USER=estudiarapp
POSTGRES_PASSWORD=change-me-with-a-long-random-password

# Backend
JWT_SECRET=change-me-with-at-least-32-random-chars
JWT_EXPIRES_IN=1h

# Optional AI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
